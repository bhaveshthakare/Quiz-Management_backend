# Copy to .env and fill in your values

# MySQL connection (Aiven: Service URI -> connect with)
DB_URL=jdbc:mysql://localhost:3306/quiz_platform?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=yourpassword

# JWT (use a long random string in production, at least 32 chars)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRATION=604800000

# Frontend origin (comma separated for multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Default admin created on first start
ADMIN_EMAIL=admin@quizplatform.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Platform Admin

# SMTP for emails (Gmail app password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Where certificate PDFs are stored
CERTIFICATE_DIR=./certificates